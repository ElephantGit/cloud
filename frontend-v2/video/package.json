{
  "name": "frontend-v2-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "record": "node src/record/cli.ts",
    "studio": "remotion studio src/compose/index.ts --public-dir out",
    "render": "remotion render src/compose/index.ts --public-dir out --concurrency 50%",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@remotion/cli": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
