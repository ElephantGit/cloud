# Copy to ~/ora-demo/.env (outside the repository, shared by every worktree), fill in the key,
# then run `task v2:deepseek` from the repository root.
# The model is fixed to DeepSeek Flash (deepseek-flash at https://api.deepseek.com).
DEEPSEEK_API_KEY=

# Prepared Node assets are required, because the chat page only runs Agents. They default to
# ~/.cache/ora-v2-node, created once by `DESKTOP_REPOSITORY=<desktop clone> task v2:node:prepare`.
# V2_NODE_ASSETS_DIR=
