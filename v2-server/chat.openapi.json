                "$ref": "#/components/schemas/ChatProjectOrder"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "params",
          "requestId"
        ]
      },
      "ChatExecutor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          },
          "modelName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "agentName",
          "modelName"
        ]
      },
      "ChatExecutorList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatExecutor"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ChatSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endReason": {
            "type": "string",
            "enum": [
              "",
              "stopped",
              "deleted",
              "interrupted"
            ],
            "description": "Why the session ended: stopped, deleted, or interrupted (ended outside chat, as on a restart). Set with endedAt still null while chat is ending it, so it is readable as soon as session_ended arrives."
          }
        },
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "endReason"
        ]
      },
      "ChatConversation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "executorId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "session": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatSession"
              }
            ],
            "nullable": true,
            "description": "The conversation's one execution session; null only until its first turn is accepted. Once it has ended the conversation is read-only."
          }
        },
        "required": [
          "id",
          "projectId",
          "executorId",
          "title",
          "createdAt",
          "updatedAt",
          "session"
        ]
      },
      "ChatConversationList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatConversation"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "ChatCreateInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 200
          },
          "executorId": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "projectId",
          "executorId",
          "prompt"
        ]
      },
      "ChatMessageInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "ChatRenameInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "ChatTurn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "turnId"
        ]
      },
      "ChatAdmitted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/ChatConversation"
          },
          "turn": {
            "$ref": "#/components/schemas/ChatTurn"
          }
        },
        "required": [
          "conversation",
          "turn"
        ]
      },
      "ChatResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "cancelled",
              "failed",
              "interrupted"
            ]
          },
          "answer": {
            "type": "string"
          },
          "answerComplete": {
            "type": "boolean"
          },
          "stopReason": {
            "type": "string"
          },
          "failureCode": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "additionalProperties": true,
            "description": "ACP Usage when the provider reported it; absent on the fixed Node."
          }
        },
        "required": [
          "status",
          "answer",
          "answerComplete",
          "stopReason",
          "failureCode"
        ]
      },
      "ChatStopped": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "$ref": "#/components/schemas/ChatResult"
          }
        },
        "required": [
          "result"
        ]
      },
      "ChatHistoryRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "description": "Position in the Node history, not the event cursor."
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "The fixed Node's HistoryLine: at, seq, type (meta, update, turnEnded, ...) and its fields."
          },
          "preview": {
            "type": "boolean",
            "description": "Provisional; replaced by the settled record at the same position."
          }
        },
        "required": [
          "sequence",
          "data"
        ]
      },
      "ChatHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatHistoryRecord"
            }
          },
          "incomplete": {
            "type": "boolean"
          }
        },
        "required": [
          "records",
          "incomplete"
        ],
        "description": "A full replacement of the session's displayed history."
      },
      "ChatEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "history_snapshot",
              "turn_ended",
              "text_delta",
              "session_ended"
            ]
          },
          "turnId": {
            "type": "string"
          },
          "history": {
            "$ref": "#/components/schemas/ChatHistory"
          },
          "textDelta": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/ChatResult"
          }
        },
        "required": [
          "sequence",
          "occurredAt",
          "kind",
          "turnId"
        ],
        "description": "The data of one event-stream message."
      },
      "ChatProjectOrder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 500
          }
        },
        "required": [
          "projectIds"
        ]
      }
    }
  }
}
