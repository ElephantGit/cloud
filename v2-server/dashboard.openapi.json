  "components": {
    "schemas": {
      "DashboardSession": {
        "type": "object",
        "required": [
          "id",
          "title",
          "projectId",
          "projectName",
          "agent",
          "model",
          "status",
          "source",
          "href",
          "createdAt",
          "endedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "endedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DashboardSessionPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardSession"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "DashboardHistory": {
        "type": "object",
        "required": [
          "source",
          "records",
          "incomplete"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "persisted_snapshot"
            ]
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "incomplete": {
            "type": "boolean"
          }
        }
      },
      "DashboardRequestPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionModelAttempt"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "SessionModelAttempt": {
        "additionalProperties": false,
        "properties": {
          "durationMs": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "errorCode": {
            "nullable": true,
            "type": "string"
          },
          "finishedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "firstOutputMs": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "httpStatus": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "started",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted",
              "incomplete"
            ],
            "type": "string"
          },
          "protocol": {
            "enum": [
              "openai-completions",
              "anthropic-messages"
            ],
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "streamed": {
            "type": "boolean"
          },
          "terminalObserved": {
            "type": "boolean"
          },
          "usage": {
            "$ref": "#/components/schemas/ModelAttemptUsage"
          },
          "providerSource": {
            "type": "string",
            "description": "fixture, upstream, or unavailable for observations predating source collection"
          }
        },
        "required": [
          "id",
          "startedAt",
          "finishedAt",
          "modelId",
          "protocol",
          "streamed",
          "outcome",
          "errorCode",
          "httpStatus",
          "durationMs",
          "firstOutputMs",
          "terminalObserved",
          "usage"
        ],
        "type": "object"
      },
      "ModelAttemptUsage": {
        "additionalProperties": false,
        "description": "Provider-reported counters only. OpenAI input includes cache reads; Anthropic input excludes cache read/write. Reasoning is an output subset. Never add every field together; a missing field stays null. Complete means a terminal observation with input/output, not that every optional field exists.",
        "properties": {
          "availability": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ],
            "type": "string"
          },
          "cacheReadTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "cacheWriteTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "inputSemantics": {
            "enum": [
              "includes_cache",
              "excludes_cache",
              "unknown"
            ],
            "type": "string"
          },
          "inputTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "outputTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "reasoningTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "totalTokens": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "inputTokens",
          "outputTokens",
          "totalTokens",
          "cacheReadTokens",
          "cacheWriteTokens",
          "reasoningTokens",
          "inputSemantics",
          "availability"
        ],
        "type": "object"
      },
      "SessionModelStatistics": {
        "additionalProperties": false,
        "properties": {
          "counts": {
            "additionalProperties": false,
            "properties": {
              "cancelled": {
                "format": "int64",
                "type": "integer"
              },
              "failed": {
                "format": "int64",
                "type": "integer"
              },
              "incomplete": {
                "format": "int64",
                "type": "integer"
