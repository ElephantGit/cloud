  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ora_session"
      }
    },
    "schemas": {
      "Occurrence": {
        "type": "object",
        "required": [
          "id",
          "scheduleId",
          "key",
          "reason",
          "executionRef",
          "kind",
          "status",
          "scheduledAt",
          "recordedAt",
          "configVersion",
          "version",
          "released",
          "snapshot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scheduleId": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "executionRef": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "scheduled",
              "manual"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "recorded",
              "starting",
              "admission_unknown",
              "reconciling",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted",
              "skipped"
            ]
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "configVersion": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "released": {
            "type": "boolean"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  }
