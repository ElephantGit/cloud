  "components": {
    "schemas": {
      "ScheduleTarget": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ScheduleChatTarget"
          },
          {
            "$ref": "#/components/schemas/ScheduleWorkflowTarget"
          },
          {
            "$ref": "#/components/schemas/ScheduleTaskTarget"
          }
        ]
      },
      "ScheduleRule": {
        "type": "object",
        "required": [
          "kind",
          "time",
          "days",
          "hours",
          "timezone"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "daily",
              "weekdays",
              "weekly",
              "hours"
            ]
          },
          "time": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "hours": {
            "type": "integer"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "ScheduleInput": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ScheduleTarget"
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          }
        }
      },
      "ScheduleUpdate": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ScheduleTarget"
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ScheduleEnabled": {
        "type": "object",
        "required": [
          "version",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ScheduleConfig": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule",
          "id",
          "version",
          "enabled",
          "createdAt",
          "updatedAt",
          "runs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ScheduleTarget"
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ScheduleList": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleConfig"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "ScheduleError": {
        "type": "object",
        "required": [
          "code",
          "params",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ScheduleChatTarget": {
        "type": "object",
        "required": [
          "kind",
          "prompt",
          "agent",
          "model"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "chat"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      },
      "ScheduleWorkflowTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "workflowId",
          "snapshot",
          "inputs"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workflow"
            ]
          },
          "workflowId": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot": {
            "type": "string",
            "format": "uuid"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ScheduleTaskTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sourceTaskId",
          "supplementalInstruction"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "task"
            ]
          },
          "sourceTaskId": {
            "type": "string",
            "format": "uuid"
          },
          "supplementalInstruction": {
            "type": "string",
            "maxLength": 32000
          }
        }
      }
    }
  }
}
